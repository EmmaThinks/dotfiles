;; ** Variables del sistema **********************************************************

(defpoll datetime :interval "5s" "date '+%A, %H:%M'")
(defpoll current_workspace :interval "200ms" "hyprctl activeworkspace -j | jq '.id'")

;; Clima: Texto compacto (ej. "󰖐 +18°C" o condición actual) con actualización cada 15 min
(defpoll weather_text :interval "15m" "curl -s --max-time 2 'wttr.in/?format=1' 2>/dev/null || echo '󰖐 --°C'")

;; Red: Detecta si hay conexión activa (Wi-Fi o Ethernet)
(defpoll network_status :interval "5s" "nmcli -t -f TYPE,STATE dev | grep -q 'connected' && echo 'connected' || echo 'disconnected'")
(defpoll network_ssid :interval "10s" "nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2")

;; Audio: Nivel de volumen y detección de mute
(defpoll volume_percent :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)}'")
(defpoll volume_muted :interval "1s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3 == \"[MUTED]\" ? \"yes\" : \"no\")}'")

;; Media
(defpoll media_title :interval "2s" "playerctl metadata --format '{{title}} • {{artist}}' 2>/dev/null || echo ''")
(defpoll media_status :interval "1s" "playerctl status 2>/dev/null || echo 'Stopped'")
(deflisten cava_bars :initial "" "~/.config/eww/scripts/cava.sh")



;; ** Widgets ************************************************************************

(defwidget left []
  (box :class "left-box" :orientation "h" :space-evenly false :halign "start" :spacing 10
    (label :class "distro-icon" :text "󰣇")
    (label :class "distro-name" :text "Arch Linux")))

(defwidget center []
  (box :class "center-box" :orientation "h" :space-evenly false :halign "center" :spacing 8
    (revealer :transition "crossfade" :reveal {media_title != ""} :duration "300ms"
      (button :class "media-pill" :onclick "playerctl play-pause"
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "media-icon" :text {media_status == "Playing" ? "󰐊" : "󰏤"})
          ;; Límite de ancho aplicado al texto para evitar desbordes
          (label :class "media-text" :limit-width 35 :text media_title)
          ;; Se desactiva el truncado automático (adiós a los "...")
          (label :class "cava-bars" :show-truncated false :text cava_bars))))))

(defwidget right []
  (box :class "right-box" :orientation "h" :space-evenly false :halign "end" :spacing 12
    ;; Workspaces 1 al 6
    (box :class "workspaces" :orientation "h" :spacing 4
      (button :class {current_workspace == 1 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'" "1")
      (button :class {current_workspace == 2 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'" "2")
      (button :class {current_workspace == 3 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'" "3")
      (button :class {current_workspace == 4 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'" "4")
      (button :class {current_workspace == 5 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'" "5")
      (button :class {current_workspace == 6 ? "ws-active" : "ws-inactive"} :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'" "6"))

    (label :class "separator" :text "│")

    ;; Clima
    (box :class "weather-widget" :orientation "h" :space-evenly false :spacing 6
      (label :class "weather-label" :text weather_text))

    (label :class "separator" :text "│")

    ;; Botón de Red / Wi-Fi (clic abre nmtui en ventana flotante de Alacritty
    (button :class "network-btn"
            :onclick "alacritty --class float-term -e nmtui &"
            :tooltip {network_ssid != "" ? network_ssid : "Network Manager"}
      (box :orientation "h" :spacing 6
        (label :class {network_status == "connected" ? "net-connected" : "net-disconnected"}
               :text {network_status == "connected" ? "󰤨" : "󰤭"})))

    (eventbox :onscroll "if [ '{}' = 'up' ]; then wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-; fi"
              :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      (box :class "volume-widget" :orientation "h" :spacing 6
        (label :class {volume_muted == "yes" ? "vol-muted" : "vol-active"}
               :text {volume_muted == "yes" ? "󰝟" : (volume_percent == 0 ? "󰕿" : (volume_percent < 50 ? "󰖀" : "󰕾"))})
        (label :class "vol-text" :text {volume_muted == "yes" ? "Mute" : "${volume_percent}%"})))

    (label :class "separator" :text "│")

    ;; Fecha y Reloj
    (label :class "datetime-label" :text datetime)))

(defwidget bar_layout []
  (centerbox :class "main-bar"
    (left)
    (center)
    (right)))

(defwindow bar
  :monitor "DP"
  :geometry (geometry :x "0%"
                      :y "0px"
                      :width "100%"
                      :height "30px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar_layout))
