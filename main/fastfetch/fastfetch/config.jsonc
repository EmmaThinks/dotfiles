{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/bandmaid.txt",
    "color": {
      "1": "green",
      "2": "yellow"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "yellow",
      "title": "green" 
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name} // ARCH SYSTEMS",
      "color": {
        "user": "green",
        "at": "white",
        "host": "yellow"
      }
    },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "OS", "keyColor": "green" },
    { "type": "kernel", "key": "KRNL", "keyColor": "green" },
    { "type": "wm", "key": "WM", "keyColor": "green" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "yellow" },
    { "type": "packages", "key": "PKGS", "keyColor": "yellow" },
    "break",
    { "type": "cpu", "key": "CPU", "keyColor": "cyan" },
    { "type": "gpu", "key": "GPU", "keyColor": "cyan" },
    { "type": "memory", "key": "RAM", "keyColor": "cyan" },
    { "type": "disk", "key": "DISK", "keyColor": "magenta", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
