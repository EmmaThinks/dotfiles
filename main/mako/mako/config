# Formato general y tipografía
font=JetBrainsMono Nerd Font 10
width=340
height=120
margin=12
padding=14
border-size=1
border-radius=8
icons=1
max-icon-size=48
default-timeout=5000
layer=overlay

# Paleta Everforest Dark Hard
background-color=#272e33f2
text-color=#d3c6aa
border-color=#a7c080cc

# Prioridades
[urgency=low]
border-color=#7a8478cc
default-timeout=3000

[urgency=normal]
border-color=#a7c080cc

[urgency=high]
border-color=#e67e80cc
text-color=#e67e80
default-timeout=0
